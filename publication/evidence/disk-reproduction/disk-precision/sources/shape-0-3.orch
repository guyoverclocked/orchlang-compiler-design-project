workflow Precision budget 10000 { input x:text max_tokens 64; input flag:boolean max_tokens 1; input other:boolean max_tokens 1; secret s:boolean max_tokens 1; model m=mock("precision-v1") max_tokens 8; model n=mock("precision-other") max_tokens 8; prompt start(t:text)->text="Seed:{t}"; prompt next(t:text)->text="Next:{t}"; prompt different(t:text)->text="Other:{t}"; if s {let a:text=call start(x) using m; let b:text=call next(a) using m;} else {let a:text=call start(x) using m; let b:text=call next(a) using m;if flag {} else {}} output "done"; }
