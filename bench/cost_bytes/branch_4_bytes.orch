workflow Branch4Bytes budget 100000000 {
  input source: text max_bytes 480;
  model small = mock("offline-small") max_tokens 150 tokenizer mockbpe overhead 3 max_bytes 900;
  model large = mock("offline-large") max_tokens 600 tokenizer mockbpe overhead 3 max_bytes 2400;
  prompt step(payload: text) -> text = "Process this payload: {payload}";
  let head: text = call step(source) using small;
  if tokens(head) <= 75 {
    let a0: text = call step(source) using small;
    let a1: text = call step(source) using small;
    let a2: text = call step(source) using small;
    let a3: text = call step(source) using small;
  } else {
    let b0: text = call step(source) using large;
    let b1: text = call step(source) using large;
    let b2: text = call step(source) using large;
    let b3: text = call step(source) using large;
  }
  output head;
}
