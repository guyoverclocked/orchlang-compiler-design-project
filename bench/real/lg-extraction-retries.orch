// Port of langchain-ai/langgraph@23961cff61a42b52525f3b20b4094d8d2fba1744,
// docs/docs/tutorials/extraction/retries.ipynb (id lg-extraction-retries): the
// first example, bind_validator_with_retries(llm, tools=[Respond]) with the
// default max_attempts = 3, asked "Does P = NP?".  See bench/real/PROTOCOL.md.
//
// llm -> validator -> (finalizer | fallback -> validator ...): at most three
// model calls, the fallback being the same model.  Each later attempt sees the
// earlier attempts and the validator's error messages (pydantic's message about
// the previous answer, which quotes the Respond validator's text), so the
// attempts are unrolled rather than written as an OrchLang retry, whose body
// cannot see an earlier attempt.  The error messages are local text, declared
// as trusted inputs of up to 8192 bytes (P6).  claude-3-haiku-20240307, whose
// ChatAnthropic default max_tokens is 4096 (langchain-anthropic 1.3.1 profile);
// no tokenizer is published for it.  The tool schema is appended as JSON (P4).
//
// Adaptations: A1 (the tool call is passed on whole); A3 (the exit once the
// answer validates is dropped: all three attempts always run).
workflow LgExtractionRetries budget 1000000000 {
  input question: text max_bytes 8192;
  input error1: text max_bytes 8192;
  input error2: text max_bytes 8192;
  model haiku = mock("anthropic/claude-3-haiku-20240307") max_tokens 4096;
  prompt respond1(question: text) -> text =
      "Respond directly by calling the Respond function.\n\n{question}\n\n{{\"name\": \"Respond\", \"input_schema\": {{\"properties\": {{\"reason\": {{\"description\": \"Step-by-step justification for the answer.\", \"type\": \"string\"}}, \"answer\": {{\"type\": \"string\"}}}}, \"required\": [\"reason\", \"answer\"], \"type\": \"object\"}}, \"description\": \"Use to generate the response. Always use when responding to the user\"}}";
  prompt respond2(question: text, attempt1: text, error1: text) -> text =
      "Respond directly by calling the Respond function.\n\n{question}\n\n{attempt1}\n\n{error1}\n\n{{\"name\": \"Respond\", \"input_schema\": {{\"properties\": {{\"reason\": {{\"description\": \"Step-by-step justification for the answer.\", \"type\": \"string\"}}, \"answer\": {{\"type\": \"string\"}}}}, \"required\": [\"reason\", \"answer\"], \"type\": \"object\"}}, \"description\": \"Use to generate the response. Always use when responding to the user\"}}";
  prompt respond3(question: text, attempt1: text, error1: text, attempt2: text, error2: text) -> text =
      "Respond directly by calling the Respond function.\n\n{question}\n\n{attempt1}\n\n{error1}\n\n{attempt2}\n\n{error2}\n\n{{\"name\": \"Respond\", \"input_schema\": {{\"properties\": {{\"reason\": {{\"description\": \"Step-by-step justification for the answer.\", \"type\": \"string\"}}, \"answer\": {{\"type\": \"string\"}}}}, \"required\": [\"reason\", \"answer\"], \"type\": \"object\"}}, \"description\": \"Use to generate the response. Always use when responding to the user\"}}";
  let attempt1: text = call respond1(question) using haiku;
  let attempt2: text = call respond2(question, attempt1, error1) using haiku;
  let attempt3: text = call respond3(question, attempt1, error1, attempt2, error2) using haiku;
  output attempt3;
}
