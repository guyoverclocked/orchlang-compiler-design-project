workflow EqualSizeTemplate budget 1000000 {
  secret s: text max_tokens 8;
  secret flag: boolean max_tokens 1;
  input x: text max_tokens 100;
  input y: text max_tokens 100;
  model m = mock("offline-m") max_tokens 60;
  model n = mock("offline-n") max_tokens 400;
  prompt step(payload: text) -> text = "Process this payload: {payload}";
  prompt ack(t: text) -> text = "Acknowledge briefly: {t}";
  prompt esc(t: text) -> text = "Escalate in detail!: {t}";
  if flag {
    let a: text = call esc(x) using m;
  } else {
    let b: text = call ack(x) using m;
  }
  output "done";
}
