// Expected: E230 because a secret is passed to a prompt and used as output.
workflow SecretExposure budget 100 {
  secret API_KEY;
  model local = mock("offline") max_tokens 40;
  prompt classify(message: text) -> text = "Classify: {message}";
  let result: text = call classify(API_KEY) using local;
  output API_KEY;
}
