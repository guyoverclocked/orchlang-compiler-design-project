workflow AliasSameContract budget 1000 {
  secret choose: boolean max_tokens 1;
  input source: text max_tokens 32;
  model primary = mock("shared-id") max_tokens 4;
  model backup = mock("shared-id") max_tokens 4;
  prompt ask(t: text) -> text = "Request: {t}";
  if choose {
    let result_left: text = call ask(source) using primary;
  } else {
    let result_right: text = call ask(source) using backup;
  }
  output "complete";
}
