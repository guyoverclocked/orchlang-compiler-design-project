workflow ExactTemplate budget 1000 {
  secret choose: boolean max_tokens 1;
  input source: text max_tokens 32;
  model shared = mock("research-model") max_tokens 4;
  prompt ask_left(t: text) -> text = "Request: {t}";
  prompt ask_right(t: text) -> text = "Request: {t}";
  if choose {
    let result_left: text = call ask_left(source) using shared;
  } else {
    let result_right: text = call ask_right(source) using shared;
  }
  output "complete";
}
