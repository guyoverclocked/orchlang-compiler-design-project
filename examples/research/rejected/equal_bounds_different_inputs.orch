workflow DifferentInputs budget 1000 {
  secret choose: boolean max_tokens 1;
  input left_source: text max_tokens 32;
  input right_source: text max_tokens 32;
  model shared = mock("research-model") max_tokens 4;
  prompt ask(t: text) -> text = "Request: {t}";
  if choose {
    let result_left: text = call ask(left_source) using shared;
  } else {
    let result_right: text = call ask(right_source) using shared;
  }
  output "complete";
}
