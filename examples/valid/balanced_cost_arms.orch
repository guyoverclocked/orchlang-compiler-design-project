// The same shape as examples/invalid/cost_channel.orch, made safe by giving the
// two arms the same cost.  The branch still depends on a secret, but the token
// bill no longer does, so nothing leaks through it.
workflow BalancedCostArms budget 100000 {
  input src: text max_tokens 50;
  secret ALERT: boolean max_tokens 1;
  model small = mock("offline-small") max_tokens 150;

  prompt step(payload: text) -> text = "Process: {payload}";

  if ALERT {
    let a: text = call step(src) using small;
  } else {
    let b: text = call step(src) using small;
  }

  output src;
}
