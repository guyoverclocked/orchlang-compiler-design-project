{
  "format": "orchlang-request-graph",
  "version": 1,
  "name": "finite_private_chain",
  "chars_per_token": 4,
  "inputs": {
    "query": {
      "type": "text",
      "label": "public",
      "max_tokens": 32
    },
    "route": {
      "type": "boolean",
      "label": "secret"
    }
  },
  "models": {
    "m": {
      "provider": "mock",
      "model": "cycle-worker",
      "max_tokens": 16,
      "unit_price": 0.001
    }
  },
  "registers": {
    "a": {
      "model": "m"
    },
    "b": {
      "model": "m"
    },
    "x": {
      "model": "m"
    },
    "y": {
      "model": "m"
    }
  },
  "entry": "choose",
  "states": {
    "choose": {
      "calls": [],
      "next": {
        "kind": "secret",
        "guard": {
          "value": "route"
        },
        "then": "left",
        "else": "right"
      }
    },
    "left": {
      "calls": [
        {
          "model": "m",
          "template": "Process {value}",
          "arguments": [
            {
              "value": "query"
            }
          ],
          "result": "a"
        },
        {
          "model": "m",
          "template": "Process {value}",
          "arguments": [
            {
              "value": "a"
            }
          ],
          "result": "b"
        }
      ],
      "next": {
        "kind": "stop"
      }
    },
    "right": {
      "calls": [
        {
          "model": "m",
          "template": "Process {value}",
          "arguments": [
            {
              "value": "query"
            }
          ],
          "result": "x"
        },
        {
          "model": "m",
          "template": "Process {value}",
          "arguments": [
            {
              "value": "x"
            }
          ],
          "result": "y"
        }
      ],
      "next": {
        "kind": "stop"
      }
    },
    "stop": {
      "calls": [],
      "next": {
        "kind": "stop"
      }
    }
  }
}
