{
  "format": "orchlang-request-graph",
  "version": 1,
  "name": "biased_productive_cycle",
  "chars_per_token": 1,
  "inputs": {
    "secret": {
      "type": "boolean",
      "label": "secret"
    }
  },
  "models": {
    "m": {
      "provider": "offline",
      "model": "finite-worker",
      "max_tokens": 8
    }
  },
  "registers": {
    "r": {
      "model": "m"
    }
  },
  "entry": "choose",
  "states": {
    "choose": {
      "calls": [],
      "next": {
        "kind": "secret",
        "guard": {
          "value": "secret"
        },
        "then": "left",
        "else": "right"
      }
    },
    "left": {
      "calls": [
        {
          "model": "m",
          "template": "A",
          "arguments": [],
          "result": "r"
        }
      ],
      "next": {
        "kind": "public",
        "guard": {
          "value": "r",
          "op": "<=",
          "limit": 1
        },
        "then": "left",
        "else": "done"
      }
    },
    "right": {
      "calls": [
        {
          "model": "m",
          "template": "B",
          "arguments": [],
          "result": "r"
        }
      ],
      "next": {
        "kind": "public",
        "guard": {
          "value": "r",
          "op": "<=",
          "limit": 1
        },
        "then": "right",
        "else": "done"
      }
    },
    "done": {
      "calls": [],
      "next": {
        "kind": "stop"
      }
    }
  }
}
