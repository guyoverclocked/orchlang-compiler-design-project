        {
          "response": "ok",
          "output_tokens": 1,
          "probability": "1"
        }
      ]
    },
    {
      "model": "m",
      "template": "NEXT",
      "ordinal": 1,
      "arguments": [
        "blue"
      ],
      "outcomes": [
        {
          "response": "ok",
          "output_tokens": 3,
          "probability": "1"
        }
      ]
    },
    {
      "model": "m",
      "template": "NEXT",
      "ordinal": 1,
      "arguments": [
        "pink"
      ],
      "outcomes": [
        {
          "response": "ok",
          "output_tokens": 1,
          "probability": "1/2"
        },
        {
          "response": "ok",
          "output_tokens": 3,
          "probability": "1/2"
        }
      ]
    }
