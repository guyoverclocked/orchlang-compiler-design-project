{
  "format": "orchlang-finite-outcome-kernel",
  "version": 1,
  "history_window": 0,
  "defaults": {
    "m": [
      {
        "response": "ok",
        "output_tokens": 1,
        "probability": "1"
      }
    ]
  },
  "rules": [
    {
      "model": "m",
      "template": "FIRST",
