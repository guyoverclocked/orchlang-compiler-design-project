workflow DataflowCertificate budget 10000 {
    input topic: text max_tokens 64;
    input include_summary: boolean max_tokens 1;
    secret s: boolean max_tokens 1;
    model m = mock("dataflow-demo-v1") max_tokens 64;
    prompt first(t: text) -> text = "Start:{t}";
    prompt next(t: text) -> text = "Next:{t}";
    if s {
        let a: text = call first(topic) using m;
        let b: text = call next(a) using m;
    } else {
        model alias = mock("dataflow-demo-v1") max_tokens 64;
        let response: text = call first(topic) using alias;
        let following: text = call next(response) using alias;
    }
    if include_summary {
        let summary: text = call first(topic) using m;
    } else {
    }
    output "done";
}
