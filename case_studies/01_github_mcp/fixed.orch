// Case study 1, fixed: the GitHub MCP "toxic agent flow".
// Invariant Labs, 26 May 2025: https://invariantlabs.ai/blog/mcp-github-vulnerability
//
// The only change from vulnerable.orch is one line.  The agent may still draft
// a patch from the issue, but nothing it writes reaches a public pull request
// until a maintainer has read it.  The compiler cannot check that the review
// happens; what it guarantees is that the gate is declared, that it carries a
// reason, and that the reason appears in the certificate for audit.
workflow IssueTriageAgentReviewed budget 20000 {
  input issue_body: text untrusted max_tokens 1500;
  secret private_repo: text max_tokens 4000;
  model agent = mock("coding-agent") max_tokens 1200;
  tool open_pull_request(body: text);

  prompt resolve(issue: text, context: text) -> text =
      "Resolve this issue: {issue} Repository context: {context}";

  declassify(private_repo) as repo_context: text because "the developer lets their own agent read their private repositories";
  let patch: text = call resolve(issue_body, repo_context) using agent;
  endorse(patch) as reviewed_patch: text because "a maintainer reads the diff before the pull request is opened";
  emit open_pull_request(reviewed_patch);
  output patch;
}
