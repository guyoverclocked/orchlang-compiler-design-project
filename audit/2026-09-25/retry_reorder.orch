// F9. Found in this project's own v4 code while writing the soundness proof
// for the bill observer: reordering calls inside a retry body.  A retry
// attempt's success is decided on its transcript, whose order a validator may
// depend on, so the number of attempts -- and the invoice -- can change.  An
// intermediate v4 build accepted this; the released one rejects it.
workflow RetryReorder budget 100000 observer bill {
  secret flag: boolean max_tokens 1;
  input x: text max_tokens 10;
  model m1 = mock("alpha/one") max_tokens 20;
  model m2 = mock("alpha/two") max_tokens 20;
  prompt p(t: text) -> text = "{t}";
  if flag {
    retry 4 {
      let a1: text = call p(x) using m1;
      let a2: text = call p(x) using m2;
    }
  } else {
    retry 4 {
      let b2: text = call p(x) using m2;
      let b1: text = call p(x) using m1;
    }
  }
  output "done";
}
