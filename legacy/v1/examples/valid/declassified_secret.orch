// A secret may reach a prompt only after a deliberate, justified declassification.
workflow KeyedLookup budget 1500 {
  input account: text max_tokens 60;
  secret API_KEY: text max_tokens 16;
  model lookup = mock("offline-lookup") max_tokens 400;

  prompt describe(reference: text) -> text = "Describe account {reference}";

  declassify(API_KEY) as key_fingerprint: text because "only the SHA-256 prefix is forwarded";
  let description: text = call describe(account) using lookup;

  require tokens(description) <= 400;
  output description;
}
