// Expected: E232 because a secret reaches an external tool.
workflow LeakToTool budget 900 {
  input note: text max_tokens 50;
  secret API_KEY: text;
  model local = mock("offline") max_tokens 100;
  tool notify(body: text);

  prompt echo(message: text) -> text = "Echo: {message}";

  let copy: text = call echo(note) using local;
  emit notify(API_KEY);

  output copy;
}
