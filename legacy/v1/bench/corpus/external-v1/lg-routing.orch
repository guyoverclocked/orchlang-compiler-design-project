workflow LGRouting budget 100000 {
  input x: text max_tokens 256;
  model m = mock("lg-bounded") max_tokens 64;
  input story_route: boolean max_tokens 1;
  input joke_route: boolean max_tokens 1;
  prompt router(t: text) -> text = "Route to story, joke or poem: {t}";
  prompt respond(t: text) -> text = "{t}";
  let decision: text = call router(x) using m;
  if story_route { let a: text = call respond(x) using m; }
  else { if joke_route { let b: text = call respond(x) using m; }
         else { let c: text = call respond(x) using m; } }
  output x;
}
