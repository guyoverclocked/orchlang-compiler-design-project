workflow LGChain budget 100000 {
  input x: text max_tokens 256;
  model m = mock("lg-bounded") max_tokens 64;
  input improve: boolean max_tokens 1;
  prompt first(t: text) -> text = "Write a joke about {t}";
  prompt improve_joke(t: text) -> text = "Improve this joke: {t}";
  prompt polish(t: text) -> text = "Polish this joke: {t}";
  let joke: text = call first(x) using m;
  if improve {
    let better: text = call improve_joke(joke) using m;
    let final: text = call polish(better) using m;
  }
  output joke;
}
