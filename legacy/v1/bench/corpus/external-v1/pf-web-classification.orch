workflow PFWeb budget 100000 {
  input page: text untrusted max_tokens 2000;
  input url: text max_tokens 64;
  model m = mock("pf-web-default") max_tokens 128;
  prompt summarize(t: text) -> text = "Summarize page: {t}";
  prompt classify(t: text, u: text) -> text = "Classify {u} using {t}";
  let summary: text = call summarize(page) using m;
  let category: text = call classify(summary, url) using m;
  output category;
}
