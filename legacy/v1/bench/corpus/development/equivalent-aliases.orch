workflow EquivalentAliases budget 1000 {
  secret s: boolean max_tokens 1;
  input x: text max_tokens 10;
  prompt p(t: text) -> text = "{t}";
  if s {
    model left = mock("same-v1") max_tokens 10;
    let a: text = call p(x) using left;
  } else {
    model right = mock("same-v1") max_tokens 10;
    let b: text = call p(x) using right;
  }
  output x;
}
