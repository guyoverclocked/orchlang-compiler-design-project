workflow WideInput2000 budget 100000 {
  input source: text max_tokens 2000;
  model small = mock("offline-small") max_tokens 150;
  model large = mock("offline-large") max_tokens 600;
  prompt step(payload: text) -> text = "Process this payload: {payload}";
  let a: text = call step(source) using small;
  let b: text = call step(a) using small;
  output b;
}
