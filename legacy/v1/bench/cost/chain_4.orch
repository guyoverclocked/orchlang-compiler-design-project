workflow Chain4 budget 100000 {
  input source: text max_tokens 120;
  model small = mock("offline-small") max_tokens 150;
  model large = mock("offline-large") max_tokens 600;
  prompt step(payload: text) -> text = "Process this payload: {payload}";
  let r0: text = call step(source) using small;
  let r1: text = call step(r0) using small;
  let r2: text = call step(r1) using small;
  let r3: text = call step(r2) using small;
  output r3;
}
