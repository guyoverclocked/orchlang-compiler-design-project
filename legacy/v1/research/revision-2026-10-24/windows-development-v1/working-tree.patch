+def appendText : Text → Text → Text
+  | .append a b, c => appendText a (appendText b c)
+  | .literal s, c =>
+      if s = "" then c else
+      match c with
+      | .literal t => .literal (s ++ t)
+      | .append (.literal t) d => .append (.literal (s ++ t)) d
+      | _ => .append (.literal s) c
